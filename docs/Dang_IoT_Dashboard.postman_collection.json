{
  "info": {
    "name": "Nguyễn Viết Đăng · IoT Dashboard",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "deviceId",
      "value": "1"
    },
    {
      "key": "csrfToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Đăng nhập (cookie JWT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-XSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}"
        }
      }
    },
    {
      "name": "2. Mở dashboard lấy CSRF",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/dashboard"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\"csrfToken\", pm.cookies.get(\"XSRF-TOKEN\") || \"\");"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Bình thường",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-XSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/iot/data",
        "body": {
          "mode": "raw",
          "raw": "{\"deviceId\": {{deviceId}}, \"temperature\": 30, \"humidity\": 65}"
        }
      }
    },
    {
      "name": "4. Đúng ngưỡng (không cảnh báo)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-XSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/iot/data",
        "body": {
          "mode": "raw",
          "raw": "{\"deviceId\": {{deviceId}}, \"temperature\": 50, \"humidity\": 65}"
        }
      }
    },
    {
      "name": "5. Vượt ngưỡng (cảnh báo)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-XSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/iot/data",
        "body": {
          "mode": "raw",
          "raw": "{\"deviceId\": {{deviceId}}, \"temperature\": 60, \"humidity\": 65}"
        }
      }
    },
    {
      "name": "6. Lịch sử",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/iot/data?deviceId={{deviceId}}"
      }
    },
    {
      "name": "7. Thống kê",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/iot/stats"
      }
    },
    {
      "name": "8. Nhật ký",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/iot/logs"
      }
    }
  ]
}
