{
  "info": {
    "name": "Đạt · IoT Device Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Dùng cookie từ login hiện có. Đặt email/password của tài khoản đã xác thực. Manager/Admin tạo danh mục trước; User quản lý thiết bị của mình. GET đầu tiên cung cấp XSRF-TOKEN; collection gửi X-XSRF-TOKEN khi ghi. Không chứa tài khoản hoặc secret thật."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "deviceId",
      "value": "1"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const csrf = pm.cookies.get('XSRF-TOKEN');",
          "if (csrf) pm.request.headers.upsert({key:'X-XSRF-TOKEN',value:csrf});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 · Lấy CSRF cookie",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "02 · Đăng nhập",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 · Tạo danh mục (Manager/Admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/categories",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cảm biến\",\n  \"description\": \"Các loại cảm biến IoT\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('categoryId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 · Danh sách danh mục",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/categories"
      }
    },
    {
      "name": "05 · Thêm thiết bị",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/devices",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cảm biến phòng khách\",\n  \"serialNumber\": \"SENSOR-001\",\n  \"categoryId\": {{categoryId}},\n  \"status\": \"ACTIVE\",\n  \"location\": \"Tầng 1\",\n  \"description\": \"Thiết bị demo của Đạt\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('deviceId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 · Tìm kiếm và phân trang",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/devices?q=SENSOR&categoryId={{categoryId}}&status=ACTIVE&page=0&size=10"
      }
    },
    {
      "name": "07 · Chi tiết thiết bị",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/devices/{{deviceId}}"
      }
    },
    {
      "name": "08 · Cập nhật thiết bị",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/devices/{{deviceId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cảm biến phòng khách\",\n  \"serialNumber\": \"SENSOR-001\",\n  \"categoryId\": {{categoryId}},\n  \"status\": \"MAINTENANCE\",\n  \"location\": \"Tầng 1\",\n  \"description\": \"Thiết bị demo của Đạt\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "09 · Upload ảnh (chọn file trước khi gửi)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/devices/{{deviceId}}/image",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "src": []
            }
          ]
        }
      }
    },
    {
      "name": "10 · Bỏ ảnh",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/devices/{{deviceId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Cảm biến phòng khách\",\n  \"serialNumber\": \"SENSOR-001\",\n  \"categoryId\": {{categoryId}},\n  \"status\": \"ACTIVE\",\n  \"location\": \"Tầng 1\",\n  \"description\": \"Thiết bị demo của Đạt\",\n  \"removeImage\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11 · Xóa danh mục đang dùng (mong đợi 409)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/categories/{{categoryId}}"
      }
    },
    {
      "name": "12 · Xóa thiết bị",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/devices/{{deviceId}}"
      }
    },
    {
      "name": "13 · Xóa danh mục (Manager/Admin)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/categories/{{categoryId}}"
      }
    }
  ]
}
